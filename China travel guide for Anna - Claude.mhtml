:root { --ink: #1d2433; --muted: #5b6475; --accent: #c8102e; --bg: #fbfaf7;=
 --card: #fff; --line: #e6e2da; --warn: #fff4e5; --warnline: #f0b35a; }

* { box-sizing: border-box; }

body { margin: 0px; background: var(--bg); color: var(--ink); font: 17px / =
1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; text=
-size-adjust: 100%; }

header { background: var(--accent); color: rgb(255, 255, 255); padding: 28p=
x 20px 22px; }

header h1 { margin: 0px; font-size: 1.7rem; line-height: 1.2; }

header p { margin: 8px 0px 0px; opacity: 0.9; font-size: 0.95rem; }

nav { position: sticky; top: 0px; background: rgb(255, 255, 255); border-bo=
ttom: 1px solid var(--line); overflow-x: auto; white-space: nowrap; padding=
: 10px 12px; z-index: 5; }

nav a { display: inline-block; margin-right: 14px; color: var(--accent); te=
xt-decoration: none; font-weight: 600; font-size: 0.9rem; }

main { max-width: 720px; margin: 0px auto; padding: 16px 18px 60px; }

section { background: var(--card); border: 1px solid var(--line); border-ra=
dius: 14px; padding: 6px 20px 14px; margin: 18px 0px; scroll-margin-top: 56=
px; }

h2 { font-size: 1.25rem; margin: 16px 0px 8px; }

ul { padding-left: 1.2em; margin: 8px 0px; }

li { margin: 6px 0px; }

.warn { background: var(--warn); border-left: 4px solid var(--warnline); pa=
dding: 10px 14px; border-radius: 8px; margin: 10px 0px; }

.small { color: var(--muted); font-size: 0.85rem; }

code { background: rgb(241, 238, 232); padding: 1px 5px; border-radius: 4px=
; font-size: 0.9em; word-break: break-all; }

.check li { list-style: none; margin-left: -1.2em; }

.check input { transform: scale(1.25); margin-right: 10px; accent-color: va=
r(--accent); }

.em { display: flex; gap: 10px; flex-wrap: wrap; margin: 8px 0px; }

.em span { background: rgb(241, 238, 232); border-radius: 8px; padding: 6px=
 10px; font-weight: 600; }
